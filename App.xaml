<Application x:Class="Sniffer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- Palette: graphite greys with a violet accent -->
        <Color x:Key="BgColor">#17161C</Color>
        <Color x:Key="PurpleColor">#8B5CF6</Color>
        <Color x:Key="PurpleLightColor">#B59BFF</Color>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="Surface" Color="#211F28" />
        <SolidColorBrush x:Key="Surface2" Color="#2B2934" />
        <SolidColorBrush x:Key="Surface3" Color="#353340" />
        <SolidColorBrush x:Key="Stroke" Color="#34313E" />
        <SolidColorBrush x:Key="Text" Color="#F3F2F7" />
        <SolidColorBrush x:Key="TextMuted" Color="#9E9AAE" />
        <SolidColorBrush x:Key="TextFaint" Color="#6E6A7E" />
        <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
        <SolidColorBrush x:Key="PurpleHover" Color="#9D74F8" />
        <SolidColorBrush x:Key="PurplePressed" Color="#7444E6" />
        <SolidColorBrush x:Key="PurpleLight" Color="{StaticResource PurpleLightColor}" />
        <SolidColorBrush x:Key="PurpleSoft" Color="#2A2240" />
        <SolidColorBrush x:Key="Amber" Color="#F5B841" />
        <SolidColorBrush x:Key="AmberSoft" Color="#3A2F1C" />
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C4DFF" Offset="0" />
            <GradientStop Color="#A78BFA" Offset="1" />
        </LinearGradientBrush>

        <!-- Steer the Fluent controls (text box, combo box, focus marks) to the same violet. -->
        <Color x:Key="SystemAccentColor">#8B5CF6</Color>
        <Color x:Key="SystemAccentColorLight1">#9D74F8</Color>
        <Color x:Key="SystemAccentColorLight2">#B59BFF</Color>
        <Color x:Key="SystemAccentColorLight3">#CDBDFF</Color>
        <Color x:Key="SystemAccentColorDark1">#7444E6</Color>
        <Color x:Key="SystemAccentColorDark2">#5B2FC9</Color>
        <Color x:Key="SystemAccentColorDark3">#4521A3</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B59BFF" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B59BFF" />
        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#8B5CF6" />

        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Text -->
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="Foreground" Value="{StaticResource PurpleLight}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Buttons -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PurpleLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Purple}" />
            <Setter Property="BorderBrush" Value="#9F7CFA" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PurpleHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PurplePressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Surface2}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PurpleLight}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PurpleSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header pill showing the connected phone; doubles as the picker when several are plugged in -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="12,7">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="Tag" Value="pick" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Surface2}" />
                    <Setter Property="Cursor" Value="Hand" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Rounded violet progress bar -->
        <Style x:Key="PurpleBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="{StaticResource Surface2}" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource PurpleGradient}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round badge holding a large glyph -->
        <Style x:Key="HeroBadge" TargetType="Border">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="Background" Value="{StaticResource PurpleSoft}" />
            <Setter Property="BorderBrush" Value="#3B2F5C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource PurpleLight}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
