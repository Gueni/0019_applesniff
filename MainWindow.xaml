<Window x:Class="Sniffer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sniffer"
        Icon="Assets/sniffer.ico"
        Width="580" Height="780" MinWidth="500" MinHeight="720"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/sniffer.png" Width="42" Height="42" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Sniffer" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock Text="Phone photos &amp; videos to your PC" Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
            <Button x:Name="DevicePill" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PillButton}" Click="DevicePill_Click">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="DeviceName" Text="No phone" FontSize="12" Foreground="{StaticResource Text}"
                               MaxWidth="170" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeviceChevron" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="8,1,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Waiting: no device, locked, or scanning -->
        <StackPanel x:Name="PanelWait" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,48">
            <Border Style="{StaticResource HeroBadge}">
                <TextBlock x:Name="WaitIcon" Text="&#xE8EA;" Style="{StaticResource HeroGlyph}" />
            </Border>
            <TextBlock x:Name="WaitTitle" Text="Connect your iPhone" Style="{StaticResource HeroTitle}" />
            <TextBlock x:Name="WaitText" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                       Text="Plug it into this PC with a USB cable. It will be detected automatically." />
            <ProgressBar x:Name="WaitBar" IsIndeterminate="True" Width="220" Margin="0,26,0,0" Foreground="{StaticResource Purple}"
                         Visibility="Collapsed" />
            <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource BaseButton}" HorizontalAlignment="Center"
                    Margin="0,26,0,0" Visibility="Collapsed" Click="Rescan_Click" />
            <!-- Connected but not scanned: nothing is read from the phone until asked -->
            <StackPanel x:Name="ConnectedActions" HorizontalAlignment="Center" Margin="0,26,0,0" Visibility="Collapsed">
                <Button Content="Scan photos &amp; videos" Style="{StaticResource PrimaryButton}" MinWidth="240" Padding="24,12"
                        FontSize="14" Click="Rescan_Click" />
                <Button x:Name="ConnectedSendButton" Content="Send files to phone…" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Click="Send_Click"
                        ToolTip="Copy files from this PC to the phone's Download folder. You can also drop files on this window." />
            </StackPanel>
        </StackPanel>

        <!-- Ready: summary, destination, start -->
        <Grid x:Name="PanelReady" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                            <TextBlock Text="Photos" Style="{StaticResource Label}" Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="StatPhotos" Text="0" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                            <TextBlock Text="Videos" Style="{StaticResource Label}" Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="StatVideos" Text="0" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                            <TextBlock Text="Total size" Style="{StaticResource Label}" Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="StatSize" Text="0 MB" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="COPY TO" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestBox" IsReadOnly="True" VerticalContentAlignment="Center" Cursor="Arrow" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>

                    <TextBlock Text="ORGANIZE" Style="{StaticResource Label}" Margin="0,16,0,8" />
                    <ComboBox x:Name="LayoutBox" SelectionChanged="Option_Changed" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="By month  (2025 \ 2025-11)" />
                        <ComboBoxItem Content="Same folders as on the phone" />
                        <ComboBoxItem Content="Everything in one folder" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="WHAT TO COPY" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="PhotosCheck" Content="Photos" VerticalAlignment="Center" Click="Option_Changed" />
                        <CheckBox x:Name="VideosCheck" Grid.Column="1" Content="Videos" Margin="18,0,0,0" VerticalAlignment="Center" Click="Option_Changed" />
                        <ComboBox x:Name="DateBox" Grid.Column="2" Margin="18,0,0,0" MinWidth="150" HorizontalAlignment="Right"
                                  SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Taken any time" />
                            <ComboBoxItem Content="Last 7 days" />
                            <ComboBoxItem Content="Last 30 days" />
                            <ComboBoxItem Content="Last 12 months" />
                            <ComboBoxItem Content="Since a date…" />
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SinceRow" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Only photos and videos taken on or after" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <DatePicker x:Name="SincePicker" Grid.Column="1" Width="170" SelectedDateChanged="Option_Changed" />
                    </Grid>
                    <CheckBox x:Name="AutoCheck" Margin="0,14,0,0" Click="Option_Changed"
                              Content="Start copying automatically when a phone is connected" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="PlanText" Grid.Row="3" Style="{StaticResource Muted}" Margin="4,12,4,0" VerticalAlignment="Top" />

            <StackPanel Grid.Row="4">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Choose a folder to start"
                        HorizontalAlignment="Stretch" Padding="0,14" FontSize="15" IsEnabled="False" Click="Start_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="SendButton" Content="Send files to phone…" Style="{StaticResource GhostButton}" Margin="0,0,16,0"
                            ToolTip="Copy files from this PC to the phone's Download folder. You can also drop files on this window."
                            Click="Send_Click" />
                    <Button Content="Rescan phone" Style="{StaticResource GhostButton}" Click="Rescan_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Copying -->
        <Grid x:Name="PanelCopy" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,24">
                <TextBlock x:Name="CopyPercent" Text="0%" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource Text}" />
                <ProgressBar x:Name="CopyBar" Style="{StaticResource PurpleBar}" Minimum="0" Maximum="1" Margin="0,16,0,18" />
                <TextBlock x:Name="CopyCounts" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="CopySpeed" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,24,0,0" HorizontalAlignment="Center" MaxWidth="440">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;" Style="{StaticResource Glyph}" Margin="0,0,9,0" />
                        <TextBlock x:Name="CopyFile" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0" FontSize="12"
                           Foreground="{StaticResource TextFaint}" Text="Keep the phone plugged in and unlocked until this finishes." />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Row="1" Content="Cancel" Style="{StaticResource BaseButton}" HorizontalAlignment="Stretch"
                    Padding="0,13" Click="Cancel_Click" />
        </Grid>

        <!-- Finished -->
        <Grid x:Name="PanelDone" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,24">
                <Border x:Name="DoneBadge" Style="{StaticResource HeroBadge}">
                    <TextBlock x:Name="DoneIcon" Text="&#xE73E;" Style="{StaticResource HeroGlyph}" />
                </Border>
                <TextBlock x:Name="DoneTitle" Text="All done" Style="{StaticResource HeroTitle}" />
                <TextBlock x:Name="DoneText" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" />
                <TextBlock x:Name="DoneTip" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                           Margin="0,14,0,0" FontSize="12" Visibility="Collapsed" />
                <Button x:Name="ErrorsButton" Content="Show what failed" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Visibility="Collapsed" Click="Errors_Click" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Back" Style="{StaticResource BaseButton}" HorizontalAlignment="Stretch" Padding="0,13" Click="Back_Click" />
                <Button x:Name="OpenFolderButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Open folder" HorizontalAlignment="Stretch"
                        Padding="0,13" Click="OpenFolder_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
