<Window x:Class="AppleSniff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppleSniff"
        Width="560" Height="660" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AppleSniff" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Copy photos and videos from your iPhone" Style="{StaticResource Muted}" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DeviceDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="DeviceName" Text="No iPhone" FontSize="13" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Waiting: no device, locked, or scanning -->
        <StackPanel x:Name="PanelWait" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,40">
            <TextBlock x:Name="WaitIcon" Text="&#xE8EA;" Style="{StaticResource HeroIcon}" />
            <TextBlock x:Name="WaitTitle" Text="Connect your iPhone" Style="{StaticResource HeroTitle}" />
            <TextBlock x:Name="WaitText" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                       Text="Plug it into this PC with a USB cable. It will be detected automatically." />
            <ProgressBar x:Name="WaitBar" IsIndeterminate="True" Width="220" Margin="0,24,0,0" Visibility="Collapsed" />
            <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="18,6"
                    Visibility="Collapsed" Click="Rescan_Click" />
        </StackPanel>

        <!-- Ready: summary, destination, start -->
        <Grid x:Name="PanelReady" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Photos" Style="{StaticResource Label}" />
                        <TextBlock x:Name="StatPhotos" Text="0" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Videos" Style="{StaticResource Label}" />
                        <TextBlock x:Name="StatVideos" Text="0" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Total size" Style="{StaticResource Label}" />
                        <TextBlock x:Name="StatSize" Text="0 MB" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Copy to" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DestBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="16,6" Click="Browse_Click" />
                    </Grid>

                    <TextBlock Text="Organize" Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <ComboBox x:Name="LayoutBox" SelectionChanged="Layout_Changed" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="By month  (2025 \ 2025-11)" />
                        <ComboBoxItem Content="Same folders as on the iPhone" />
                        <ComboBoxItem Content="Everything in one folder" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock x:Name="PlanText" Grid.Row="2" Style="{StaticResource Muted}" Margin="2,14,2,0" VerticalAlignment="Top" />

            <StackPanel Grid.Row="3">
                <Button x:Name="StartButton" Style="{DynamicResource AccentButtonStyle}" Content="Choose a folder to start"
                        HorizontalAlignment="Stretch" Padding="0,12" FontSize="15" FontWeight="SemiBold" IsEnabled="False" Click="Start_Click" />
                <Button Content="Rescan iPhone" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="14,6"
                        Background="Transparent" BorderThickness="0" Click="Rescan_Click" />
            </StackPanel>
        </Grid>

        <!-- Copying -->
        <Grid x:Name="PanelCopy" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CopyPercent" Text="0%" FontSize="56" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar x:Name="CopyBar" Minimum="0" Maximum="1" Height="6" Margin="0,14,0,16" />
                <TextBlock x:Name="CopyCounts" FontSize="15" HorizontalAlignment="Center" />
                <TextBlock x:Name="CopySpeed" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="CopyFile" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0" FontSize="12"
                           Text="Keep the iPhone plugged in and unlocked until this finishes." />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Row="1" Content="Cancel" HorizontalAlignment="Stretch" Padding="0,12" Click="Cancel_Click" />
        </Grid>

        <!-- Finished -->
        <Grid x:Name="PanelDone" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DoneIcon" Text="&#xE930;" Style="{StaticResource HeroIcon}" />
                <TextBlock x:Name="DoneTitle" Text="All done" Style="{StaticResource HeroTitle}" />
                <TextBlock x:Name="DoneText" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" />
                <TextBlock x:Name="DoneTip" Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                           Margin="0,14,0,0" FontSize="12" Visibility="Collapsed" />
                <Button x:Name="ErrorsButton" Content="Show what failed" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,6"
                        Visibility="Collapsed" Click="Errors_Click" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Back" HorizontalAlignment="Stretch" Padding="0,12" Click="Back_Click" />
                <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" Content="Open folder" HorizontalAlignment="Stretch"
                        Padding="0,12" FontWeight="SemiBold" Click="OpenFolder_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
